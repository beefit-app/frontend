{
  "name": "beefit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:remote": "vite build --mode remote",
    "dev": "vite",
    "dev:remote": "vite --mode remote",
    "lint": "eslint src --max-warnings 200",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript http://localhost:8080/v3/api-docs -o src/app/types/api.generated.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:sync:remote": "vite build --mode remote && npx cap sync",
    "mobile:apk:remote": "npm run mobile:sync:remote && cd android && JAVA_HOME=$HOME/.jdks/jdk-21.0.6+7 ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} ./gradlew assembleDebug",
    "mobile:android": "CAPACITOR_ANDROID_STUDIO_PATH=${CAPACITOR_ANDROID_STUDIO_PATH:-/snap/bin/android-studio} npx cap open android",
    "mobile:ios": "npx cap open ios"
  },
