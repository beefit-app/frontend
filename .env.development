# Configuracao padrao de `npm run dev`. Versionado de proposito: antes disso cada
# pessoa precisava lembrar de exportar VITE_API_URL e VITE_DEV_AUTH_BYPASS na linha
# de comando, e esquecer nao dava erro — dava um app que parecia funcionar sem tocar
# no backend. Foi assim que um cadastro quebrado chegou em producao.
#
# Este arquivo VENCE o .env.local de cada maquina: a precedencia do Vite e
# .env -> .env.local -> .env.[mode] -> .env.[mode].local -> variaveis do shell.
# Nao carrega em `npm run build`, que roda em modo production.
#
# Para rodar contra backend local, criar `.env.development.local` (ignorado pelo
# Git), que vence este:
#
#   VITE_API_URL=http://localhost:8080
#   VITE_DEV_AUTH_BYPASS=true

VITE_API_URL=https://beefit-api.onrender.com
VITE_DEV_AUTH_BYPASS=false
