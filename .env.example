# URL HTTPS da API usada pelos builds de produção e homologação.
VITE_API_URL=https://api.example.com

# Use true somente com uma VITE_API_URL de loopback em builds locais.
VITE_ALLOW_INSECURE_LOCAL_API=false

# Permitido apenas em desenvolvimento local; nunca defina em builds de release.
VITE_DEV_AUTH_BYPASS=false
