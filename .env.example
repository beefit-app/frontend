# Este arquivo e so documentacao: o Vite NAO le `.env.example`.
#
# Para desenvolvimento voce nao precisa criar nada. O `.env.development`
# versionado ja aponta `npm run dev` para o backend em producao
# (https://beefit-api.onrender.com) com o bypass de autenticacao desligado, e ele
# vence o `.env.local` de cada maquina.
#
# Se voce ja tinha um `.env.local` so com VITE_DEV_AUTH_BYPASS=true, ele ficou
# REDUNDANTE e atrapalha: em dev o `.env.development` o sobrescreve, mas
# `npm run build` roda em modo production, nao carrega o `.env.development` e volta
# a enxergar o bypass — falhando com "VITE_DEV_AUTH_BYPASS=true nao e permitido em
# builds distribuidos" antes mesmo de reclamar da URL. Pode apagar o arquivo.
#
# ---------------------------------------------------------------------------
# Rodar contra um backend local
# ---------------------------------------------------------------------------
# Criar `.env.development.local` (ignorado pelo Git), que vence o versionado:
#
#   VITE_API_URL=http://localhost:8080
#   VITE_ALLOW_INSECURE_LOCAL_API=true
#   VITE_DEV_AUTH_BYPASS=true
#
# ---------------------------------------------------------------------------
# Duas armadilhas ao testar contra o deploy
# ---------------------------------------------------------------------------
# 1. A porta TEM de ser 5173. O CORS do backend libera exatamente
#    http://localhost:5173; 5174 e 3000 sao bloqueados. Se a 5173 estiver
#    ocupada o Vite troca de porta sozinho e as requisicoes falham com um erro
#    que nao menciona CORS.
#
# 2. A instancia free hiberna. Fria, a primeira resposta leva ~60s e o
#    apiClient desiste em 15s, parecendo servidor fora do ar. Antes de testar:
#    curl -m 420 https://beefit-api.onrender.com/actuator/health
#
# ---------------------------------------------------------------------------
# Variaveis, e o que cada uma faz
# ---------------------------------------------------------------------------

# URL da API. Obrigatoria no build, que falha sem ela. Sem valor, `buildUrl`
# lanca erro antes do fetch e nenhuma requisicao sai.
VITE_API_URL=https://api.example.com

# Permite VITE_API_URL em HTTP; so aceita host de loopback e so faz sentido com
# backend local. Builds distribuidos exigem HTTPS.
VITE_ALLOW_INSECURE_LOCAL_API=false

# Com `true`, o login e simulado e NENHUMA requisicao vai ao backend — util
# offline, e perigoso ao testar integracao, porque tudo parece funcionar.
# O build recusa `true`.
VITE_DEV_AUTH_BYPASS=false
